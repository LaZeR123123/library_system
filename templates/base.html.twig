<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Library System{% endblock %}</title>
        <script src="https://cdn.tailwindcss.com"></script>
    </head>
    <body class="bg-gray-50">
        <nav class="bg-blue-700 p-4 text-white shadow-md mb-6">
            <div class="container mx-auto flex gap-6">
                <a href="{{ path('app_home') }}" class="font-bold hover:text-blue-200">Головна</a>
                <a href="{{ path('app_book_list') }}" class="hover:text-blue-200">Каталог книг</a>
            </div>
        </nav>

        <div class="container mx-auto px-4">
            {% for message in app.flashes('success') %}
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
                    {{ message }}
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </div>
    </body>
</html>
