{% extends 'base.html.twig' %}

{% block body %}
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">Наявні книги</h1>
        <a href="{{ path('app_book_new') }}" class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700">+ Додати</a>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <ul class="divide-y divide-gray-200">
            {% for item in items %}
                <li class="p-4 hover:bg-gray-50 transition flex items-center gap-3">
                    <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
                    <span class="text-lg">{{ item }}</span>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
